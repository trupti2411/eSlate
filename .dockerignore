# Heavy dirs that get rebuilt inside the container anyway
node_modules
api/vendor
client/node_modules
dist

# Local-only state that must NEVER ship
api/.env
api/database/database.sqlite
api/database/dump.sql
api/storage/logs/*
api/storage/app/private/*
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/bootstrap/cache/*.php
client/.env.local

# Git + IDE noise
.git
.github
.vscode
.idea
.claude

# OS noise
.DS_Store
Thumbs.db

# Docs / tests that don't belong in the container
docs
attached_assets
*.md
!api/README.md
