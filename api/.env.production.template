# Copy this file to /home/<USER>/api.dev.eslate.com.au/.env on the cPanel server,
# then fill in the values marked <FILL>. DO NOT commit the real .env to git.

APP_NAME=eSlate
APP_ENV=production
APP_KEY=<FILL>
# ↑ Generate locally with: php artisan key:generate --show
# ↑ Then paste the `base64:...` string here.

APP_DEBUG=false
APP_URL=https://api.dev.eslate.com.au

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── Database — MySQL via cPanel ─────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<FILL>
# ↑ cPanel auto-prefixes DB names with your cPanel username,
# ↑ e.g. if you create "eslate_dev" it becomes "<cpaneluser>_eslate_dev".
# ↑ Use the FULL prefixed name here.
DB_USERNAME=<FILL>
# ↑ Same prefix rule — e.g. "<cpaneluser>_eslateapp".
DB_PASSWORD=<FILL>

# ── Sessions / cache — use database since we have MySQL anyway ──────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.eslate.com.au

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Sanctum — domain the frontend lives on, so cookie-based auth works ──────
SANCTUM_STATEFUL_DOMAINS=dev.eslate.com.au,api.dev.eslate.com.au

# ── Filesystem ──────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail — pick one. cPanel ships SMTP credentials per email account. ───────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@eslate.com.au"
MAIL_FROM_NAME="eSlate"
