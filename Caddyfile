{
    # Render terminates TLS upstream; we just serve HTTP on $PORT.
    auto_https off
    admin off
    persist_config off
}

# Render sets $PORT at container start (typically 10000). Bind directly.
# Caddy's {$VAR:default} syntax expands at config-load time, so this works
# whether PORT is set (Render) or not (local docker run).
:{$PORT:8080} {
    root * /app/public

    encode gzip zstd

    # Laravel's front controller handles every dynamic request.
    php_server

    # Health check — Render pings this every few minutes.
    handle /healthz {
        respond "ok" 200
    }

    log {
        output stderr
        format console
    }
}
